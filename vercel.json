{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/styles", "destination": "/styles.html" },
    { "source": "/brochure", "destination": "/brochure.html" },
    { "source": "/web-development", "destination": "/services/web-development.html" },
    { "source": "/web-development.html", "destination": "/services/web-development.html" },
    { "source": "/app-development", "destination": "/services/mobile-app-development.html" },
    { "source": "/mobile-app-development", "destination": "/services/mobile-app-development.html" },
    { "source": "/mobile-app-development.html", "destination": "/services/mobile-app-development.html" },
    { "source": "/social-media", "destination": "/services/social-media-management.html" },
    { "source": "/social-media-management", "destination": "/services/social-media-management.html" },
    { "source": "/social-media-management.html", "destination": "/services/social-media-management.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
